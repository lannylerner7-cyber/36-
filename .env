# Local development only. Never commit real credentials.
# In Replit, add sensitive values through Secrets instead.
DATABASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
TOKEN_ENCRYPTION_KEY=
REMOVE_BG_API_KEY=

# The API server requires a port. Replit workflows provide this automatically.
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Vite frontend settings. The artifact workflow supplies these automatically.
BASE_PATH=/

# Optional integrations:
# GOOGLE_MAPS_API_KEY=
# ROUTING_DIRECTORY_PATH=
# ROUTING_DIRECTORY_EFFECTIVE_DATE=
# ROUTING_LOGO_GOOGLE_FAVICON=false
